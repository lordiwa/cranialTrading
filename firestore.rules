rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Permitir lectura pública de usuarios (perfiles públicos)
    // Lectura: cualquiera puede ver perfiles públicos
    // Escritura: solo el dueño
    //
    // ⚠️ TASK-188 — ESTE DOCUMENTO ES PÚBLICO. NO METER DATOS PERSONALES ACÁ.
    // La lectura abierta es deliberada: mirar el perfil de otro usuario SIN
    // sesión es requisito de producto. Pero las reglas de Firestore se evalúan
    // por DOCUMENTO, no por campo: cualquier campo que viva acá se descarga con
    // una petición anónima, sin cuenta y sin token. Filtrar en el cliente no es
    // seguridad.
    // Ya pasó tres veces: TASK-087 (users/{uid}/cards), TASK-169 (el email
    // dentro de public_cards) y TASK-188 (el email dentro de este documento —
    // medido el 2026-08-11: 134 emails en producción, 232 en dev, HTTP 200).
    // Campos permitidos: username, location, avatarUrl, createdAt,
    // lastUsernameChange, tourCompleted. El email vive en Firebase Auth y en
    // contact_info/{uid}, que exige sesión.
    // El candado automático está en tests/integration/anonymousExposure.test.ts.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth.uid == userId;

      // ✅ Colección de mazos del usuario: users/{userId}/decks/{deckId}
      //
      // TASK-215: era `allow read: if request.auth != null` — cualquier
      // usuario autenticado podía leer los mazos de cualquier otro. Medido
      // contra dev 2026-08-11 (scripts/query-subcollections-authz-probe.mjs):
      // 11/11 subcolecciones bajo users/{userId} legibles por una cuenta
      // ajena, esta incluida. Owner-only, igual que /cards y /card_index.
      match /decks/{deckId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Colección de cartas del usuario — PRIVADA, solo el dueño.
      //
      // TASK-087: antes era `allow read: if true` con el comentario "el cliente
      // filtra por public === true". Filtrar en el cliente no es seguridad: la
      // regla se evalúa en el servidor y cualquiera podía leer la colección
      // entera y la lista de deseados de cualquier usuario sin estar logueado.
      // Verificado contra dev antes de cerrarlo: una petición REST anónima
      // devolvía HTTP 200 con los documentos de carta.
      //
      // Lo público sale por /public_cards, que tiene su propia regla de lectura
      // abierta y solo contiene cartas en venta/cambio con public === true.
      // Se revisó todo el cliente antes de cerrar: los únicos accesos a
      // users/{uid}/cards son del propio dueño; el perfil público lee
      // /public_cards. Las Cloud Functions usan el SDK admin y no pasan por
      // estas reglas.
      match /cards/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Colección de preferencias del usuario
      //
      // TASK-215: owner-only, ver nota sobre /decks arriba (mismo probe,
      // mismo hallazgo: legible por cualquier cuenta ajena antes de esto).
      match /preferences/{preferenceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Colección de matches guardados (camelCase — parece código muerto,
      // ver nota de savedContacts abajo). TASK-215: owner-only de todos modos.
      match /savedMatches/{matchId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Colección de contactos guardados (camelCase).
      //
      // TASK-215: cerrada a owner-only por consistencia con las demás, pero
      // esta colección (y su hermana savedMatches arriba) parece código
      // muerto — ningún store la lee, ni siquiera el dueño; los stores
      // reales usan matches_guardados/contactos_guardados (snake_case) más
      // abajo. No se borra en este ticket — no era el encargo (Regla 2);
      // queda anotado para un ticket aparte.
      match /savedContacts/{contactId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Price history snapshots (collection-level daily totals)
      // TASK-215: owner-only, ver nota sobre /decks arriba.
      match /priceHistory/{snapshotId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Per-card price history
      // TASK-215: owner-only, ver nota sobre /decks arriba.
      match /cardPriceHistory/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Colección de matches nuevos (calculados)
      // Cualquier usuario autenticado puede crear un match (enviar interés)
      // Solo el dueño puede leer, actualizar y eliminar
      //
      // TASK-215: el `read` decía `if request.auth != null` — no cumplía el
      // comentario de arriba ("solo el dueño puede leer"). Cerrado a
      // owner-only; el `create` NO se toca — sigue abierto a cualquier
      // autenticado a propósito, es lo que permite mandarle un match a otro
      // usuario (matches.ts).
      match /matches_nuevos/{matchId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update, delete: if request.auth.uid == userId;
      }

      // Colección de matches guardados
      // TASK-215: owner-only, ver nota sobre /decks arriba.
      match /matches_guardados/{matchId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Colección de matches eliminados
      // TASK-215: owner-only, ver nota sobre /decks arriba.
      match /matches_eliminados/{matchId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Colección de contactos guardados
      // TASK-215: owner-only, ver nota sobre /decks arriba.
      match /contactos_guardados/{contactId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Binders del usuario
      // TASK-215: owner-only, ver nota sobre /decks arriba.
      match /binders/{binderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // Lightweight card index for fast filtering & pagination.
      //
      // TASK-214: this was `allow read: if request.auth != null` — any
      // authenticated user could read ANY user's card_index directly via
      // the SDK, no Cloud Function involved. Confirmed live against dev
      // 2026-08-11 (scripts/query-card-index-authz-probe.mjs): a disposable
      // attacker account read a disposable victim's full card_index.
      // Owner-only, matching /cards above. The public-profile flow (view
      // another user's collection without a session) reads /public_cards
      // instead, which keeps its own open-read rule — this change does not
      // affect it.
      match /card_index/{chunkId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth.uid == userId;
      }

      // SCRUM-70: solicitudes de compra (carrito enviado por un visitante)
      // Crear: cualquiera (visitantes anónimos sin auth) puede enviar un carrito,
      //        pero debe llegar con status 'pending' (guardia mínima de forma).
      // Leer/gestionar: solo el dueño del perfil.
      match /buyRequests/{requestId} {
        allow create: if request.resource.data.status == 'pending';
        allow read, update, delete: if request.auth.uid == userId;
      }
    }

    // SCRUM-73: índice de unicidad de usernames. Doc ID = username normalizado (lowercase, trim).
    // Body: { uid, createdAt }. La regla create-only ES la garantía de unicidad:
    // un setDoc sobre un doc existente se evalúa como UPDATE (resource != null) y se deniega.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Sin regla update — la denegación sobre un doc existente es la señal "username ocupado".
    }

    // ========== COLECCIONES PÚBLICAS PARA MATCHES OPTIMIZADOS ==========
    // Cartas públicas (para trade/sale) - lectura pública (TASK-085: anónimos
    // ven "quién vende" en el buscador de login). Seguro porque los writers
    // (publicCards.ts) sólo publican cartas status sale/trade + public===true;
    // nunca colección/wishlist.
    match /public_cards/{docId} {
      allow read: if true;
      // Solo el dueño puede crear/actualizar (userId debe coincidir)
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // TASK-169: email de contacto, fuera de todo lo que se lee sin login.
    // Antes viajaba dentro de cada documento de public_cards y
    // public_preferences, que son de lectura abierta — cualquiera podía bajarse
    // los emails de toda la plataforma sin cuenta. Las reglas no filtran por
    // campo, así que el dato se mudó acá: leer exige estar logueado, escribir
    // exige ser el dueño. El perfil público no lo necesita y sigue abriéndose
    // sin login; el modal de contacto de matches lo pide y siempre tiene sesión.
    match /contact_info/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Preferencias públicas (lo que buscan) - cualquier autenticado puede leer
    match /public_preferences/{docId} {
      allow read: if request.auth != null;
      // Solo el dueño puede crear/actualizar (userId debe coincidir)
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Conversaciones de mensajes (a nivel raíz)
    match /conversations/{conversationId} {
      // Permitir a usuarios autenticados crear y leer conversaciones donde participan
      allow create: if request.auth != null;
      allow read, update: if request.auth != null;
      // Allow delete only if user is a participant
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      // Mensajes dentro de la conversación
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // ========== MATCHES COMPARTIDOS (INTERÉS DESDE PERFIL) ==========
    // Colección a nivel raíz para matches donde ambos usuarios pueden ver
    match /shared_matches/{matchId} {
      // Cualquier usuario autenticado puede crear
      allow create: if request.auth != null;
      // Solo participantes pueden leer y modificar
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }

    // Legacy colecciones (mantener compatibilidad con datos anteriores)
    match /colecciones/{userId}/cards/{cardId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /preferencias/{userId}/{preferenceId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /matches_guardados/{userId}/{matchId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /contactos_guardados/{userId}/{contactId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // ========== PLATFORM STATS (public read, written by Cloud Functions) ==========
    match /platform_stats/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ========== MARKET DATA (read-only, populated by Cloud Functions) ==========
    match /market_data/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /{subcol}/{subDocId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ========== SCRYFALL CARD CACHE (shared, written only by Cloud Functions) ==========
    match /scryfall_cache/{cardId} {
      allow read: if request.auth != null;
      allow create, update: if false;  // Only admin SDK (Cloud Functions) can write
      allow delete: if false;
    }

    // Scryfall ids the collection endpoint says do not resolve (TASK-247).
    // The catch-all below already denies this collection; the rule is spelled
    // out anyway because the rules of this project are deployed BY HAND, and
    // an unnamed collection is one nobody finds when they come looking. No
    // client ever reads or writes it — only the reconcile, through the admin
    // SDK, which bypasses rules entirely.
    match /scryfall_not_found/{cardId} {
      allow read, write: if false;
    }

    // Denegar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

